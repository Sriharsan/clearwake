# Default local reads none of these and makes zero provider/model calls.
# Set locally in the server environment; this file is not loaded automatically.
CLEARWAKE_SANDBOX_ACK=I_CONFIRM_SANDBOX_ONLY
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_SANDBOX_CAPTURE_ID=
CLEARWAKE_REFUND_AMOUNT=1.00

# Optional upstream Meta adapter: separate explicit CLI opt-in; may consume credits.
# See vendor/relayloom/docs/META.md. No usable free balance is presumed.
RELAYLOOM_SYNTHETIC_ONLY=I_CONFIRM_SYNTHETIC_DATA
RELAYLOOM_META_ENDPOINT=https://api.meta.ai/v1/chat/completions
RELAYLOOM_META_MODEL=muse-spark-1.3
MODEL_API_KEY=
RELAYLOOM_META_LEDGER=
RELAYLOOM_META_MAX_ATTEMPTS=6

# Optional pinned local model. No download or inference starts without CLI opt-in.
CLEARWAKE_LOCAL_AI_ACK=I_CONFIRM_LOCAL_SYNTHETIC
CLEARWAKE_LOCAL_MODEL=qwen2.5-coder:3b
CLEARWAKE_LOCAL_MODEL_DIGEST=
CLEARWAKE_LOCAL_LEDGER=

# Dispatch proof: SAM weights are gated on Hugging Face. Read only by tools/sam/setup.ps1 and never printed. See tools/sam/README.md.
HF_TOKEN=
